# Application Runtime Environment
PORT=3000
NODE_ENV=development

# Server Security & CORS
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=https://www.makepdfright.com

# API Security (Optional: Set to require API Key authorization for all endpoints)
API_ACCESS_KEY=

# AI Features (Required for Gemini AI PDF Chat, Vision OCR, Audio Transcribe, and TTS)
GEMINI_API_KEY=

# Google AdSense Monetization (Production)
VITE_ADSENSE_PUB_ID=ca-pub-0000000000000000
VITE_ADSENSE_TOP_SLOT=1234567890
VITE_ADSENSE_CONTENT_SLOT=0987654321
VITE_ADSENSE_SIDEBAR_SLOT=1122334455

# Google Analytics 4 (Production)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Performance & Worker Options
SHARP_IMAGE_CONCURRENCY=3
COMPRESSION_MIN_IMAGE_WIDTH=64
COMPRESSION_MIN_IMAGE_HEIGHT=64
COMPRESSION_MIN_IMAGE_BYTES=10240

# Cloud Tasks & Asynchronous Worker Dispatch (Production)
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=us-central1
WORKER_ENDPOINT=
WORKER_SECRET=

# Firebase Client Configuration (Production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin Configuration (Server-side override, optional if ADC is configured)
FIREBASE_PROJECT_ID=

