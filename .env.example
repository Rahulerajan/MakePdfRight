# Application Runtime Environment
PORT=3000
NODE_ENV=development

# Server Security & CORS
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=https://www.makepdfright.com
# REQUIRED in production: use at least 32 characters of cryptographically random data.
# Store this in Cloud Run / Vercel secret configuration; never commit the real value.
SESSION_SECRET=

# API Security (Optional: Set to require API Key authorization for public processing endpoints)
API_ACCESS_KEY=

# AI Features (Required for Gemini AI PDF Chat, Vision OCR, Audio Transcribe, and TTS)
GEMINI_API_KEY=

# Google AdSense Monetization (Production)
VITE_ADSENSE_PUB_ID=ca-pub-0000000000000000
VITE_ADSENSE_TOP_SLOT=1234567890
VITE_ADSENSE_CONTENT_SLOT=0987654321
VITE_ADSENSE_SIDEBAR_SLOT=1122334455

# Google Analytics 4 (Production)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Rate limits (requests per minute). Production counters are stored atomically in Firestore.
RATE_LIMIT_GENERAL=60
RATE_LIMIT_UPLOAD=15
RATE_LIMIT_PDF=20
RATE_LIMIT_AI=10
MAX_ACTIVE_JOBS_PER_OWNER=5

# Performance & Worker Options
SHARP_IMAGE_CONCURRENCY=3
COMPRESSION_MIN_IMAGE_WIDTH=64
COMPRESSION_MIN_IMAGE_HEIGHT=64
COMPRESSION_MIN_IMAGE_BYTES=10240

# Cloud Tasks & Asynchronous Worker Dispatch (Production)
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=us-central1
WORKER_ENDPOINT=
WORKER_SECRET=

# Firebase Client Configuration (Production)
# Google OAuth Web Client ID. Add both https://makepdfright.com and
# https://www.makepdfright.com as authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional Firebase App Check reCAPTCHA v3 site key. Configure the web app in
# Firebase App Check first; leave blank until monitoring is ready.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Firebase Admin override. Cloud Run's GOOGLE_CLOUD_PROJECT is also supported.
# Production rate limiting uses Firestore, so the runtime service account needs
# permission to read/write the rateLimits collection.
FIREBASE_PROJECT_ID=
# Optional comma-separated allowlist. Leave blank to allow every Google account.
AUTH_ALLOWED_EMAILS=
# Enforce only after App Check metrics confirm production requests carry tokens.
REQUIRE_FIREBASE_APP_CHECK=false
