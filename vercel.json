{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/files/upload-url",
      "destination": "/api/files?action=upload-url"
    },
    {
      "source": "/api/files/upload",
      "destination": "/api/files?action=upload"
    },
    {
      "source": "/api/files/download",
      "destination": "/api/files?action=download"
    },
    {
      "source": "/api/files/:action",
      "destination": "/api/files?action=:action"
    },
    {
      "source": "/api/pdf/job/status/:jobId",
      "destination": "/api/pdf-tools?action=job-status&jobId=:jobId"
    },
    {
      "source": "/api/pdf/job/cancel/:jobId",
      "destination": "/api/pdf-tools?action=job-cancel&jobId=:jobId"
    },
    {
      "source": "/api/pdf/job/create",
      "destination": "/api/pdf-tools?action=job-create"
    },
    {
      "source": "/api/pdf/job/status",
      "destination": "/api/pdf-tools?action=job-status"
    },
    {
      "source": "/api/pdf/job/cancel",
      "destination": "/api/pdf-tools?action=job-cancel"
    },
    {
      "source": "/api/pdf-editor-ai",
      "destination": "/api/pdf-tools?action=editor-ai"
    },
    {
      "source": "/api/pdf-editor-ocr",
      "destination": "/api/pdf-tools?action=editor-ocr"
    },
    {
      "source": "/api/pdf/:action",
      "destination": "/api/pdf-tools?action=:action"
    },
    {
      "source": "/api/generate-image",
      "destination": "/api/ai-tools?action=generate-image"
    },
    {
      "source": "/api/chat-pdf",
      "destination": "/api/ai-tools?action=chat-pdf"
    },
    {
      "source": "/api/analyze-image",
      "destination": "/api/ai-tools?action=analyze-image"
    },
    {
      "source": "/api/transcribe-audio",
      "destination": "/api/ai-tools?action=transcribe-audio"
    },
    {
      "source": "/api/generate-speech",
      "destination": "/api/ai-tools?action=generate-speech"
    },
    {
      "source": "/api/complex-query",
      "destination": "/api/ai-tools?action=complex-query"
    },
    {
      "source": "/:path(compress|compress-.*|reduce-.*|merge|merge-.*|combine|combine-.*|split|split-.*|extract-.*|delete-.*|how-to-.*|pdf-.*|image-.*|word-.*|edit|edit-.*|rotate|rotate-.*|organise|organize|ocr|generate-image|image-generator|transcribe|audio-.*|about|contact|privacy|terms|cookie-policy|disclaimer)",
      "destination": "/:path/index.html"
    },
    {
      "source": "/((?!api/|_next/|_static/|[\\w-]+\\.\\w+).*)",
      "destination": "/index.html"
    }
  ]
}
