{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/merge-pdf",
      "destination": "/merge",
      "permanent": true
    },
    {
      "source": "/split-pdf",
      "destination": "/split",
      "permanent": true
    },
    {
      "source": "/compress-pdf",
      "destination": "/compress",
      "permanent": true
    },
    {
      "source": "/edit-pdf",
      "destination": "/edit",
      "permanent": true
    },
    {
      "source": "/pdf-editor",
      "destination": "/edit",
      "permanent": true
    },
    {
      "source": "/rotate-pdf",
      "destination": "/rotate",
      "permanent": true
    },
    {
      "source": "/organize",
      "destination": "/organise",
      "permanent": true
    },
    {
      "source": "/image-generator",
      "destination": "/generate-image",
      "permanent": true
    },
    {
      "source": "/audio-transcribe",
      "destination": "/transcribe",
      "permanent": true
    },
    {
      "source": "/word-to-pdf",
      "destination": "/pdf-to-word",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/files/upload-url",
      "destination": "/api/files?action=upload-url"
    },
    {
      "source": "/api/files/upload",
      "destination": "/api/files?action=upload"
    },
    {
      "source": "/api/files/download",
      "destination": "/api/files?action=download"
    },
    {
      "source": "/api/files/:action",
      "destination": "/api/files?action=:action"
    },
    {
      "source": "/api/pdf/job/status/:jobId",
      "destination": "/api/pdf-tools?action=job-status&jobId=:jobId"
    },
    {
      "source": "/api/pdf/job/cancel/:jobId",
      "destination": "/api/pdf-tools?action=job-cancel&jobId=:jobId"
    },
    {
      "source": "/api/pdf/job/create",
      "destination": "/api/pdf-tools?action=job-create"
    },
    {
      "source": "/api/pdf/job/status",
      "destination": "/api/pdf-tools?action=job-status"
    },
    {
      "source": "/api/pdf/job/cancel",
      "destination": "/api/pdf-tools?action=job-cancel"
    },
    {
      "source": "/api/pdf-editor-ai",
      "destination": "/api/pdf-tools?action=editor-ai"
    },
    {
      "source": "/api/pdf-editor-ocr",
      "destination": "/api/pdf-tools?action=editor-ocr"
    },
    {
      "source": "/api/pdf/:action",
      "destination": "/api/pdf-tools?action=:action"
    },
    {
      "source": "/api/generate-image",
      "destination": "/api/ai-tools?action=generate-image"
    },
    {
      "source": "/api/chat-pdf",
      "destination": "/api/ai-tools?action=chat-pdf"
    },
    {
      "source": "/api/analyze-image",
      "destination": "/api/ai-tools?action=analyze-image"
    },
    {
      "source": "/api/transcribe-audio",
      "destination": "/api/ai-tools?action=transcribe-audio"
    },
    {
      "source": "/api/generate-speech",
      "destination": "/api/ai-tools?action=generate-speech"
    },
    {
      "source": "/api/complex-query",
      "destination": "/api/ai-tools?action=complex-query"
    },
    {
      "source": "/:path(pdf-to-word-without-losing-formatting|compress-pdf-without-losing-quality|merge-multiple-pdf-files-into-one|compress-pdf-for-job-application|merge-pdf-and-word-into-one-file|merge-pdf-without-losing-quality|split-pdf-without-losing-quality|extract-tables-from-pdf-to-excel|financial-statement-pdf-to-excel|merge-jpg-and-pdf-into-one-file|extract-specific-pages-from-pdf|pdf-to-word-password-protected|split-pdf-into-multiple-files|extract-single-page-from-pdf|pdf-to-word-without-software|compress-multiple-pdf-files|split-pdf-into-single-pages|pdf-bank-statement-to-excel|merge-pdf-without-software|pdf-to-word-multiple-pages|compress-pdf-for-whatsapp|reduce-pdf-size-for-email|merge-protected-pdf-files|split-pdf-without-acrobat|pdf-to-word-free-no-email|pdf-to-word-for-contracts|convert-pdf-data-to-excel|combine-pdf-files-online|merge-pdf-keep-bookmarks|split-pdf-by-page-number|split-pdf-odd-even-pages|merge-scanned-pdf-pages|split-pdf-every-n-pages|pdf-to-word-with-tables|pdf-to-word-online-free|multi-page-pdf-to-excel|compress-pdf-on-iphone|compress-pdf-under-2mb|how-to-merge-pdf-files|extract-pages-from-pdf|split-pdf-for-whatsapp|pdf-to-word-for-resume|pdf-to-excel-on-iphone|compress-pdf-to-100kb|compress-pdf-to-500kb|delete-pages-from-pdf|split-pdf-online-free|pdf-to-word-on-iphone|merge-pdf-files-free|split-large-pdf-file|split-pdf-for-upload|pdf-to-word-editable|invoice-pdf-to-excel|compress-pdf-to-1mb|merge-pdf-on-iphone|split-pdf-on-iphone|split-pdf-for-email|scanned-pdf-to-word|merge-pdf-in-order|how-to-split-a-pdf|split-pdf-by-range|separate-pdf-pages|pdf-to-xlsx-online|split-pdf-in-half|generate-image|cookie-policy|image-to-pdf|pdf-to-excel|pdf-to-word|pdf-to-jpg|transcribe|disclaimer|resources|compress|organise|contact|privacy|rotate|merge|split|about|terms|edit|ocr)",
      "destination": "/:path/index.html"
    }
  ]
}
